# secret.yaml.example — 이 파일을 복사해서 secret.yaml로 만들고 값을 채우세요.
# cp k8s/secret.yaml.example k8s/secret.yaml
#
# secret.yaml은 .gitignore에 등록되어 있으므로 절대 커밋되지 않습니다.
apiVersion: v1
kind: Secret
metadata:
  name: escape-web-secret
  namespace: escape-web
type: Opaque
stringData:
  DATABASE_URL: "file:/app/data/db.sqlite"
  NEXTAUTH_SECRET: "CHANGE_ME_IN_PRODUCTION"
  NEXTAUTH_URL: "https://your-domain.com"
  RESEND_API_KEY: ""
