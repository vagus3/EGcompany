generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                  String   @id @default(cuid())
  email               String   @unique
  name                String?
  passwordHash        String?
  employeeCode        String?  @unique
  department          String   @default("General")
  role                String   @default("employee")
  clearanceLevel      Int      @default(1)
  notificationEmail   String?
  notificationEnabled Boolean  @default(true)
  language            String   @default("ko")
  theme               String   @default("light")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  progresses Progress[]
  sessions   Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Room {
  id          String   @id @default(cuid())
  title       String
  description String?
  difficulty  Int      @default(1)
  isActive    Boolean  @default(true)
  sceneConfig Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  puzzles    Puzzle[]
  progresses Progress[]
}

model Puzzle {
  id           String     @id @default(cuid())
  roomId       String
  title        String
  type         PuzzleType
  order        Int
  data         Json
  objectConfig Json
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  room       Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  progresses Progress[]
}

model Progress {
  id        String         @id @default(cuid())
  userId    String
  roomId    String
  puzzleId  String?
  status    ProgressStatus @default(IN_PROGRESS)
  solvedAt  DateTime?
  attempts  Int            @default(0)
  hintUsed  Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  room   Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  puzzle Puzzle? @relation(fields: [puzzleId], references: [id])
}

enum PuzzleType {
  SLIDER
  PATTERN
  CODE
  LOGIC
  HIDDEN_OBJECT
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  FAILED
}
