generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                  String   @id @default(cuid())
  email               String   @unique
  name                String?
  passwordHash        String?
  employeeCode        String?  @unique
  department          String   @default("General")
  role                String   @default("employee")
  clearanceLevel      Int      @default(1)
  notificationEmail   String?
  notificationEnabled Boolean  @default(true)
  language            String   @default("ko")
  theme               String   @default("light")
  consentedAt         DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  progresses    Progress[]
  sessions      Session[]
  terminalState TerminalState?
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TerminalState {
  id                    String   @id @default(cuid())
  userId                String   @unique
  currentStage          String   @default("pin-select")
  unlockedMailIds       Json
  completedChallengeIds Json
  adminTestRequired     Boolean  @default(true)
  adminTestPassed       Boolean  @default(false)
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Room {
  id          String   @id @default(cuid())
  title       String
  description String?
  difficulty  Int      @default(1)
  isActive    Boolean  @default(true)
  sceneConfig Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  puzzles    Puzzle[]
  progresses Progress[]
}

model Puzzle {
  id           String     @id @default(cuid())
  roomId       String
  title        String
  type         PuzzleType
  order        Int
  data         Json
  objectConfig Json
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  room       Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  progresses Progress[]
}

model Progress {
  id        String         @id @default(cuid())
  userId    String
  roomId    String
  puzzleId  String?
  status    ProgressStatus @default(IN_PROGRESS)
  solvedAt  DateTime?
  attempts  Int            @default(0)
  hintUsed  Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  room   Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  puzzle Puzzle? @relation(fields: [puzzleId], references: [id])
}

// 외부 AI 힌트 시스템이 기록하는 hint_logs 테이블을 읽기 전용으로 매핑.
// user_email 컬럼에는 플레이어의 웹 로그인 이메일이 기록되며, 웹앱은 이 값으로
// 유저별 힌트 사용 횟수를 집계해 사원증 등급(S/A/B)을 결정한다.
model HintLog {
  id          Int      @id @default(autoincrement())
  gameId      String   @map("game_id")
  userEmail   String?  @map("user_email")
  stageNumber Int?     @map("stage_number")
  hintLevel   Int?     @map("hint_level")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("hint_logs")
}

enum PuzzleType {
  SLIDER
  PATTERN
  CODE
  LOGIC
  HIDDEN_OBJECT
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  FAILED
}
