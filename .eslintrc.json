{
  "extends": [
    "next/core-web-vitals",
    "plugin:jsdoc/recommended"
  ],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "project": "./tsconfig.json"
  },
  "plugins": [
    "simple-import-sort",
    "jsdoc",
    "@typescript-eslint"
  ],
  "rules": {
    "simple-import-sort/imports": "error", // import 구문을 알파벳 및 그룹 순으로 자동 정렬
    "simple-import-sort/exports": "error", // export 구문을 자동 정렬

    "jsdoc/require-jsdoc": ["warn", {
      "require": {
        "FunctionDeclaration": true, // 일반 함수 선언 위에는 JSDoc(/** ... */) 작성 강제
        "MethodDefinition": true,    // 클래스 내 메서드 위에도 JSDoc 작성 강제
        "ClassDeclaration": true,    // 클래스 선언 위에도 JSDoc 작성 강제
        "ArrowFunctionExpression": false // 화살표 함수는 예외(너무 빡빡하지 않게)
      }
    }],
    "jsdoc/require-param": "off", // JSDoc 내에 @param 파라미터 타입 명시는 번거로울 수 있어 강제 해제
    "jsdoc/require-returns": "off", // JSDoc 내에 @returns 리턴 타입 명시 강제 해제
    "jsdoc/require-description": "warn", // 단, JSDoc 작성 시 이 코드가 무슨 역할을 하는지 설명(description)은 꼭 적도록 경고

    "eol-last": ["error", "always"], // 파일 맨 끝에 무조건 빈 줄(엔터) 하나를 유지 (Git diff 경고 방지)
    "no-underscore-dangle": ["error", { "allow": ["_id", "_meta"], "allowAfterThis": true }], // 변수명 앞뒤에 무의미한 언더스코어(__) 금지 (단, DB에서 쓰는 _id 등은 허용)
    "no-useless-rename": "error", // import/export 시 같은 이름으로 굳이 이름 변경하는 것 금지 (ex: import { a as a })
    "no-unneeded-ternary": "error", // 굳이 필요 없는 삼항 연산자 금지 (ex: x === 1 ? true : false -> x === 1 로 권장)
    "no-useless-computed-key": "error", // 불필요하게 계산된 객체 키 금지 (ex: { ['a']: 1 } -> { a: 1 })
    "no-useless-concat": "error", // 불필요한 문자열 덧셈 금지 (ex: 'a' + 'b' -> 'ab')
    "@typescript-eslint/no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }], // 선언해놓고 쓰지 않는 변수 경고 (단, 의도적으로 _로 시작하게 지은 이름은 무시)

    "@typescript-eslint/member-ordering": ["error", {
      "default": [
        "signature", // 인덱스 시그니처
        "public-static-field", // public 정적 변수
        "protected-static-field", // protected 정적 변수
        "private-static-field", // private 정적 변수
        "public-instance-field", // public 인스턴스 변수
        "protected-instance-field", // protected 인스턴스 변수
        "private-instance-field", // private 인스턴스 변수
        "constructor", // 생성자 (constructor)
        "public-instance-method", // public 메서드 (기능)
        "protected-instance-method", // protected 메서드
        "private-instance-method" // private 메서드
      ]
    }], // 클래스/DAO 내부 변수 및 함수 작성 순서를 정해 한눈에 구조를 파악하게 만듦

    "@typescript-eslint/consistent-type-imports": ["error", { "prefer": "type-imports" }], // 타입을 가져올 땐 무조건 'import type'으로 명시해 빌드 시 번들 최적화
    "@typescript-eslint/no-floating-promises": "error", // Prisma 쿼리 등 비동기 함수 호출 시 await를 빼먹어 오류를 놓치는 실수 방지
    "@typescript-eslint/no-misused-promises": "error", // 비동기(Promise)를 boolean 조건문 등에 잘못 사용하는 것 금지
    "no-console": ["warn", { "allow": ["warn", "error"] }], // console.log()가 서버 터미널이나 유저에게 남는 것 방지 (warn, error 로그만 허용)
    "react/jsx-no-useless-fragment": "warn" // 태그가 하나뿐인데 무의미하게 <></> 프래그먼트로 감싸는 것 방지
  }
}